# Settings the app reads. For local development don't copy this by hand:
# `npm run db:start` then `npm run env:local` writes .env.local with the local values.
# Production values go in Vercel's environment variables (see docs/DEPLOY.md).

# Postgres, used by the app's server code and the ML pipeline.
# Production: the Supabase pooled connection string (Transaction mode, port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for consent records and account deletion. Keep it secret.
SUPABASE_SECRET_KEY=

# Magic-link sign-in, password reset and confirmation emails. Leave false until a
# custom SMTP sender is set up in Supabase (and email confirmation turned back on).
NEXT_PUBLIC_AUTH_EMAIL_LINKS=false

# Show "Continue with Google" once a Google OAuth client is set up in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=false

# Bearer token Vercel Cron sends to /api/cron/fill-picks.
CRON_SECRET=change-me
